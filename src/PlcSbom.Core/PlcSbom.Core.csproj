<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlcSbom.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- CycloneDX 1.6.2 JSON schemas, embedded so validation works offline (CLAUDE.md section 2). -->
    <EmbeddedResource Include="Validation/Schemas/*.json" LogicalName="PlcSbom.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlcSbom.Tests" />
  </ItemGroup>
</Project>
