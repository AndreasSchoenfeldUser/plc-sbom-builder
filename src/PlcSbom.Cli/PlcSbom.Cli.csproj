<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>plc-sbom</AssemblyName>
    <RootNamespace>PlcSbom.Cli</RootNamespace>
  </PropertyGroup>
  <!-- Delivery (CLAUDE.md section 11): self-contained single file, no installed .NET runtime needed.
       Applies to `dotnet publish -r <rid>`; build and test stay framework-dependent.
       No trimming: NJsonSchema and Newtonsoft.Json use reflection (E-005, E-008). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PlcSbom.Core/PlcSbom.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlcSbom.Tests" />
  </ItemGroup>
</Project>
