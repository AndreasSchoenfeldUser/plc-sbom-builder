<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Synthetic fixture (Comquent). Structure follows the real projects in fixtures/twincat/; covers what
     they do not show: an EtherCAT drive of another vendor (VendorId #x00000024 as IndraDrive MPB20 in
     Inxton/TcOpen TcoDrivesBeckhoff), an I/O device kept in its own file (File=), a PLC project with a
     LibraryReference of fixed version and a PlaceholderResolution with fixed version. Network values
     are documentation addresses (RFC 5737). -->
<TcSmProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.beckhoff.com/schemas/2012/07/TcSmProject" TcSmVersion="1.0" TcVersion="3.1.4026.24">
	<Project ProjectGUID="{00000000-0000-0000-0000-000000000001}" TargetNetId="192.0.2.50.1.1" Target64Bit="true">
		<Plc>
			<Project GUID="{00000000-0000-0000-0000-000000000002}" Name="Zelle" PrjFilePath="Zelle\Zelle-synthetisch.plcproj" TmcFilePath="Zelle\Zelle.tmc" AmsPort="851"/>
		</Plc>
		<Io>
			<Device Id="1" DevType="111" AmsPort="28673" AmsNetId="192.0.2.50.2.1" RemoteName="Device 1 (EtherCAT)">
				<Name>Device 1 (EtherCAT)</Name>
				<Box Id="1" BoxType="9099">
					<Name>Term 1 (EK1100)</Name>
					<EtherCAT SlaveType="1" VendorId="#x00000002" ProductCode="#x044c2c52" RevisionNo="#x00120000" Type="EK1100 EtherCAT Coupler (2A E-Bus)" Desc="EK1100"/>
					<Box Id="2" BoxType="9099">
						<Name>Term 2 (EL1008)</Name>
						<EtherCAT SlaveType="2" VendorId="#x00000002" ProductCode="#x03f03052" RevisionNo="#x00120000" Type="EL1008 8Ch. Dig. Input 24V, 3ms" Desc="EL1008"/>
					</Box>
				</Box>
				<Box Id="3" BoxType="9099">
					<Name>Drive 3 (IndraDrive MPB20)</Name>
					<EtherCAT SlaveType="2" EtherCatAddr="1003" VendorId="#x00000024" ProductCode="#x00242804" RevisionNo="#x00000003" Type="IndraDrive MPB20" Desc="IndraDrive MPB20"/>
				</Box>
			</Device>
			<Device File="Device 2 (EtherCAT).xti" Id="2"/>
		</Io>
	</Project>
</TcSmProject>
